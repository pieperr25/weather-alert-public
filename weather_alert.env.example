# NWS requests require an identifying User-Agent. Include a real contact address.
NWS_USER_AGENT="daily-weather-alert/1.0 (you@example.com)"

# Gmail: smtp.gmail.com / 587 / STARTTLS, using an app password.
# SendGrid: smtp.sendgrid.net / 587 / STARTTLS, username is literally "apikey".
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="you@example.com"
SMTP_PASSWORD="replace-with-an-app-password"
SMTP_FROM="you@example.com"
SMTP_TO="you@example.com"
SMTP_STARTTLS="true"
SMTP_USE_SSL="false"

# Optional. The default is coords.json beside weather_alert.py.
# COORDS_FILE="/absolute/path/to/coords.json"

# Optional. Without this setting all failures remain completely silent.
# WEATHER_ALERT_LOG_FILE="/absolute/path/to/weather_alert.log"

# Hosted dynamic-time mode. The GitHub workflow sets these automatically.
# RUN_ONLY_AT_LOCAL_HOUR="18"
# MAX_COORDINATE_AGE_HOURS="3"
